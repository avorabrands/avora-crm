# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Used for admin tasks (inviting users) and the seed script.
# Never prefix with NEXT_PUBLIC_ and never import it from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in auth redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional integrations (not configured in v1) ──────────────────────────
# When set, the notification dispatcher will deliver email in addition to
# in-app notifications. Leave blank to keep in-app only.
RESEND_API_KEY=
EMAIL_FROM="Avora Brands <crm@avorabrands.com>"
# WHATSAPP_API_TOKEN=

# Protects /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string
